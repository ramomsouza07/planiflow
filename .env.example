# Supabase PostgreSQL Connection String (Session Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# JWT Secret for Session Signing
JWT_SECRET="seu_jwt_secret_super_seguro_aqui_2026"

# Chave de Criptografia AES-256 para dados sensíveis (32 bytes / 256 bits)
ENCRYPTION_KEY="sua_chave_criptografica_aes256_super_secreta_2026"

# Backend Port
PORT=3001

# Frontend API URL (em produção no Netlify, aponte para a URL do Render, ex: https://seu-app.onrender.com)
VITE_API_URL=""
